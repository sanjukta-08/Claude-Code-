# Copy to .env for local testing. In GitHub Actions, set these as repo Secrets.

# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Image host (recommended: imgbb — free, no public-repo requirement)
# Get key at https://api.imgbb.com/  (free, instant signup)
IMGBB_API_KEY=
# Force a specific host (auto-detects imgbb if key is set, else falls back to github raw)
# IMAGE_HOST=imgbb

# Canva Connect API (https://www.canva.com/developers/)
CANVA_ACCESS_TOKEN=
CANVA_BRAND_TEMPLATE_ID=

# Instagram Graph API (Business / Creator account)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# LinkedIn API (w_member_social scope)
LINKEDIN_ACCESS_TOKEN=
# Personal: urn:li:person:XXXX   Company page: urn:li:organization:XXXX
LINKEDIN_PERSON_URN=

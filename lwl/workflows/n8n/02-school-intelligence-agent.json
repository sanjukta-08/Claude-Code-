      "name": "Webhook · /lwl-school-intel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_API_KEY }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $env.CLAUDE_MODEL || 'claude-sonnet-4-20250514' }}\",\n  \"max_tokens\": 1024,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"You are an LWL school intelligence analyst. Research {{ $json.body.school_name }} (domain {{ $json.body.domain }}). Return ONLY valid JSON with these 12 fields and no markdown: curriculum (IB|British|American|National|Hybrid), ib_status (YES|NO|Candidate), grades_served, est_enrollment (number), tuition_usd_per_year (number), country_iso2, region (UAE|US|UK|IN|KR|SG|LATAM|EU|OTHER), is_yale_camp_eligible (boolean — true ONLY if US-based), lwl_fit_score (0-100), best_lwl_programme (FDSP|Edge|Research|Onward|Yale|Harvard), urgency_signals (array of short strings), recent_news (short string).\"\n  }]\n}"
      },
      "id": "claude",
      "name": "Claude · Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apollo.io/v1/organizations/enrich",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.APOLLO_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"domain\": \"{{ $json.body.domain }}\" }"
      },
      "id": "apollo-org",
      "name": "Apollo · Org",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apollo.io/v1/mixed_people/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.APOLLO_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"q_organization_domains\": \"{{ $json.body.domain }}\",\n  \"person_titles\": [\"Principal\",\"Head of School\",\"Admissions\",\"MUN Coordinator\"],\n  \"per_page\": 5\n}"
      },
      "id": "apollo-people",
      "name": "Apollo · People",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 440]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.hunter.io/v2/domain-search?domain={{ $json.body.domain }}&api_key={{ $env.HUNTER_API_KEY }}&limit=10"
      },
      "id": "hunter",
      "name": "Hunter · Domain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 560]
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook · /lwl-school-intel').item.json.body;\nconst claude = JSON.parse(($('Claude · Research').item.json.content?.[0]?.text || '{}').replace(/```json|```/g, ''));\nconst org = $('Apollo · Org').item.json.organization || {};\nconst people = $('Apollo · People').item.json.people || [];\nconst emails = $('Hunter · Domain').item.json.data?.emails || [];\n\nlet score = 0;\nif (org.id) score += 20;\nif (emails.some(e => e.verification?.status === 'valid')) score += 25;\nif (claude.ib_status === 'YES') score += 20;\nif ((claude.tuition_usd_per_year || 0) > 15000) score += 20;\nif (people.length >= 2) score += 15;\n\n// Yale Camp regional rule — US only\nconst yaleEligible = claude.is_yale_camp_eligible && claude.country_iso2 === 'US';\n\nconst profile = {\n  school_name: body.school_name,\n  domain: body.domain,\n  ...claude,\n  is_yale_camp_eligible: yaleEligible,\n  apollo_org_id: org.id,\n  org_size: org.estimated_num_employees,\n  contacts: people.map(p => ({ name: p.name, title: p.title, email: p.email, linkedin: p.linkedin_url })),\n  hunter_emails: emails.slice(0, 5).map(e => ({ value: e.value, type: e.type, confidence: e.confidence })),\n  lcs_score: score,\n  tier: score >= 70 ? 1 : score >= 40 ? 2 : 3,\n  enriched_at: new Date().toISOString(),\n  cost_estimate_usd: 0.07\n};\nreturn [{ json: profile }];"
      },
      "id": "merge",
      "name": "Merge 4 Sources → 30-field Profile",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 380]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.tier }}", "rightValue": 1, "operator": { "type": "number", "operation": "equals" } } ] }, "outputKey": "tier1" },
            { "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.tier }}", "rightValue": 2, "operator": { "type": "number", "operation": "equals" } } ] }, "outputKey": "tier2" },
            { "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.tier }}", "rightValue": 3, "operator": { "type": "number", "operation": "equals" } } ] }, "outputKey": "tier3" }
          ]
        }
      },
      "id": "switch",
      "name": "Switch · Tier",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1020, 380]
    },
    {
      "parameters": {
        "select": "user",
        "user": { "__rl": true, "value": "={{ $env.SLACK_TIER1_ABHIJEET_USER_ID }}", "mode": "id" },
        "messageType": "text",
        "text": "=:zap: *TIER 1 LEAD — 4hr SLA*\\n*{{ $json.school_name }}* ({{ $json.region }}) · LCS {{ $json.lcs_score }}\\nContact: {{ $json.contacts[0]?.name }} ({{ $json.contacts[0]?.title }}) · {{ $json.contacts[0]?.email }}\\nBest fit: *{{ $json.best_lwl_programme }}* · Tuition: ${{ $json.tuition_usd_per_year }}\\nUrgency: {{ $json.urgency_signals?.join(', ') }}"
      },
      "id": "slack-tier1",
      "name": "Slack DM · Abhijeet",
